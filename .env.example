# ElasticPress.io Configuration
# Get your credentials from https://elasticpress.io/

# ElasticPress.io Host URL
ELASTICPRESS_HOST=https://your-endpoint.elasticpress.io

# Subscription ID (also used as the index prefix)
ELASTICPRESS_SUBSCRIPTION_ID=your-subscription-id

# Subscription Token
ELASTICPRESS_SUBSCRIPTION_TOKEN=your-subscription-token

