# ElasticPress.io Configuration
# Get your credentials from https://elasticpress.io/

# ElasticPress.io Host URL
ELASTICPRESS_HOST=https://your-endpoint.elasticpress.io

# Subscription ID (also used as the index prefix)
ELASTICPRESS_SUBSCRIPTION_ID=your-subscription-id

# Subscription Token
ELASTICPRESS_SUBSCRIPTION_TOKEN=your-subscription-token

# ─── AI / Embeddings ──────────────────────────────────────────────────────────
# OpenAI-compatible API endpoint.
# Works with OpenAI, Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1),
# Groq (https://api.groq.com/openai/v1), Azure OpenAI, and any other OpenAI-compatible service.
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key

# Models — swap with local model names when using Ollama or LM Studio
# Embedding model (default: OpenAI text-embedding-3-small, 1536 dims)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat model for RAG "Ask AI" completions
OPENAI_CHAT_MODEL=gpt-5.4-mini

# Optional: override embedding dimensions (must match what the model actually produces)
# If changed after indexing, you must re-create the index and re-generate all embeddings.
# OPENAI_EMBEDDING_DIMS=1536

