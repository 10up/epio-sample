{
    "name": "10up/epio-sample",
    "description": "ElasticPress.io sample project demonstrating integration with Nobel Prize dataset",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "10up",
            "homepage": "https://10up.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ElasticPressIO\\Sample\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElasticPressIO\\Sample\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": "php bin/setup.php",
        "index": "php bin/index.php",
        "search": "php bin/search.php",
        "setup-template": "php bin/setup-template.php",
        "manage-templates": "php bin/manage-templates.php",
        "update-mapping": "php bin/update-mapping.php",
        "generate-embeddings": "php bin/generate-embeddings.php",
        "semantic-search": "php bin/semantic-search.php",
        "ask": "php bin/ask.php",
        "mcp-server": "php bin/mcp-server.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
